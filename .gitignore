# ============================
# Python Standard Ignore
# ============================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================
# Project Specific (CloudMetrix)
# ============================

# Application Data, Databases & Media
data/downloads/
data/profiles/
data/thumbnails/
data/*.json
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.csv
scratch/

# Video & Image artifacts
*.mp4
*.webm
*.png
*.webp
*.jpg
*.jpeg

# Logs
*.log
logs/

# ============================
# OS specific
# ============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
